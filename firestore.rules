rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;
      allow create: if isGoogleOwner(userId)
        && hasAllowedFields()
        && validIdentity(userId)
        && validStatsShape();
      allow update: if isGoogleOwner(userId)
        && hasAllowedFields()
        && validIdentity(userId)
        && validStatsShape()
        && validUpdateStep();
      allow delete: if false;
    }

    function isGoogleOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function hasAllowedFields() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'displayName',
        'photoURL',
        'email',
        'provider',
        'totalSolved',
        'level',
        'xp',
        'bestStreak',
        'accuracy',
        'answered',
        'correct',
        'updatedAt'
      ]);
    }

    function validIdentity(userId) {
      return request.resource.data.uid == userId
        && request.resource.data.provider == 'google.com'
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 32
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 500
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.updatedAt == request.time;
    }

    function validStatsShape() {
      return request.resource.data.totalSolved is int
        && request.resource.data.level is int
        && request.resource.data.xp is int
        && request.resource.data.bestStreak is int
        && request.resource.data.accuracy is int
        && request.resource.data.answered is int
        && request.resource.data.correct is int
        && request.resource.data.totalSolved >= 0
        && request.resource.data.level >= 1
        && request.resource.data.xp >= 0
        && request.resource.data.bestStreak >= 0
        && request.resource.data.accuracy >= 0
        && request.resource.data.accuracy <= 100
        && request.resource.data.answered >= 0
        && request.resource.data.correct >= 0
        && request.resource.data.correct <= request.resource.data.answered
        && request.resource.data.totalSolved >= request.resource.data.answered;
    }

    function validUpdateStep() {
      return request.resource.data.answered >= resource.data.answered
        && request.resource.data.correct >= resource.data.correct
        && request.resource.data.totalSolved >= resource.data.totalSolved
        && request.resource.data.bestStreak >= resource.data.bestStreak
        && request.resource.data.xp >= resource.data.xp
        && request.resource.data.level >= resource.data.level
        && request.resource.data.answered <= resource.data.answered + 120
        && request.resource.data.correct <= resource.data.correct + 120
        && request.resource.data.totalSolved <= resource.data.totalSolved + 120
        && request.resource.data.bestStreak <= resource.data.bestStreak + 120
        && request.resource.data.xp <= resource.data.xp + 1500
        && request.resource.data.level <= (request.resource.data.xp / 100) + 1;
    }
  }
}
